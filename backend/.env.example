# Backend environment variables example
# Replace values with your Cloud SQL / hosting config
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=cafe_db
DB_POOL_LIMIT=10

# If you are using Cloud SQL (GCP) with a private IP, set DB_HOST to the private IP.
# For Cloud Run, prefer using the Cloud SQL Auth Proxy or unix socket; store credentials in Secret Manager.

PORT=3000
