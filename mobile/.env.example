# Mobile app example: pass backend URL when building/running
# For Flutter, use --dart-define to inject BACKEND_URL
# Example: flutter run -d chrome --dart-define=BACKEND_URL=https://api.example.com

# Example local dev values:
# For web: http://localhost:3000
# For Android emulator: http://10.0.2.2:3000
# For iOS simulator: http://127.0.0.1:3000

# Build-time define key name: BACKEND_URL
